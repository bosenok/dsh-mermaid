{
  "name": "dsh-mermaid",
  "version": "0.1.0",
  "private": false,
  "description": "Render mermaid fenced code blocks as diagrams in DSH markdown.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosenok/dsh-mermaid.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "mermaid": "^12.2.0",
    "vite": "^8.3.4"
  }
}
